<view class="page">
  <text class="title">Animal-Island-UI Spike v1</text>
  <text class="subtitle">Native line: slot, bind events, custom-class/custom-style.</text>

  <view class="title-wrap">
    <ai-title color="app-teal" size="large">Island Kit</ai-title>
  </view>
  <ai-divider type="wave-yellow" custom-class="hero-divider"></ai-divider>

  <ai-card color="app-yellow" pattern="default" custom-class="section">
    <text class="section-title">Button</text>
    <view class="row">
      <ai-button type="primary" bind:tap="openModal">Open Modal</ai-button>
      <ai-button type="dashed">Dashed</ai-button>
      <ai-button type="primary" loading>Loading</ai-button>
    </view>
  </ai-card>

  <ai-card color="app-blue" custom-class="section">
    <text class="section-title">Icon</text>
    <view class="row">
      <ai-icon name="icon-miles" size="64rpx" bounce></ai-icon>
      <ai-icon name="icon-camera" size="64rpx"></ai-icon>
      <ai-icon name="icon-shopping" size="64rpx"></ai-icon>
    </view>
  </ai-card>

  <ai-card color="app-green" custom-class="section">
    <text class="section-title">Switch</text>
    <view class="row">
      <ai-switch checked="{{quietHours}}" checked-text="ON" unchecked-text="OFF" bind:change="handleQuietHoursChange"></ai-switch>
      <ai-switch size="small" checked="{{quietHours}}" bind:change="handleQuietHoursChange"></ai-switch>
      <ai-switch loading checked></ai-switch>
    </view>
    <text class="hint">Quiet hours: {{quietHours ? 'enabled' : 'disabled'}}</text>
  </ai-card>

  <ai-card color="app-blue" custom-class="section">
    <text class="section-title">Collapse</text>
    <view class="collapse-stack">
      <ai-collapse question="Island checklist" expanded="{{collapseOpen}}" bind:change="handleCollapseChange">
        <text>Water flowers, check mail, and visit the museum before sunset.</text>
      </ai-collapse>
      <ai-collapse question="Disabled panel" disabled>
        <text>This content stays collapsed because the panel is disabled.</text>
      </ai-collapse>
    </view>
    <text class="hint">Collapse: {{collapseStatus}}</text>
  </ai-card>

  <ai-card color="brown" custom-class="section">
    <text class="section-title">CodeBlock</text>
    <view class="code-stack">
      <ai-code-block code="{{codeBlockBasic}}"></ai-code-block>
      <ai-code-block
        code="{{codeBlockCustom}}"
        custom-style="border-radius: 5px; background-color: #242c46ff;"
      ></ai-code-block>
    </view>
  </ai-card>

  <ai-card color="warm-peach-pink" custom-class="section">
    <text class="section-title">Checkbox</text>
    <ai-checkbox options="{{taskOptions}}" value="{{tasks}}" bind:change="handleTasksChange"></ai-checkbox>
    <text class="hint">Today: {{tasksText}}</text>
  </ai-card>

  <ai-card color="app-teal" custom-class="section">
    <text class="section-title">Radio</text>
    <ai-radio options="{{seasonOptions}}" value="{{season}}" bind:change="handleSeasonChange"></ai-radio>
    <text class="hint">Season: {{season}}</text>
  </ai-card>

  <ai-card color="app-orange" custom-class="section">
    <text class="section-title">Title and Divider</text>
    <view class="title-stack">
      <ai-title size="small" color="app-yellow">Small Tag</ai-title>
      <ai-title color="purple">Ribbon Title</ai-title>
    </view>
    <ai-divider type="line-teal" custom-class="demo-divider"></ai-divider>
    <ai-divider type="dashed-brown" custom-class="demo-divider"></ai-divider>
  </ai-card>

  <ai-card type="dashed" custom-class="section">
    <text class="section-title">Input</text>
    <ai-input value="{{name}}" allow-clear shadow placeholder="Your island name" bind:change="handleNameChange" bind:clear="handleNameClear">
      <ai-icon slot="prefix" name="icon-map" size="36rpx"></ai-icon>
    </ai-input>
    <text class="hint">Current value: {{name || '-'}}</text>
  </ai-card>

  <ai-modal open="{{modalOpen}}" title="Welcome to the island" bind:close="closeModal" bind:ok="closeModal">
    <text>Modal is a native component overlay, not a Taro-compiled artifact.</text>
  </ai-modal>
</view>

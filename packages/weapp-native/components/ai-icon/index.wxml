<image
  wx:if="{{resolvedSrc}}"
  class="ai-icon ai-icon-img ai-icon-{{name}} {{bounce ? 'ai-icon-bounce' : ''}} {{customClass}}"
  style="width: {{size}}; height: {{size}}; {{customStyle}}"
  src="{{resolvedSrc}}"
  mode="aspectFit"
/>
<view
  wx:else
  class="ai-icon ai-icon-fallback ai-icon-{{name}} {{bounce ? 'ai-icon-bounce' : ''}} {{customClass}}"
  style="width: {{size}}; height: {{size}}; {{customStyle}}"
></view>

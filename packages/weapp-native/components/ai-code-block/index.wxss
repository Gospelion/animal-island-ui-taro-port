@import "../../styles/common.wxss";

.ai-code-block {
  box-sizing: border-box;
  width: 100%;
  padding: 20px 24px;
  overflow: auto;
  color: #e8d5bc;
  background: #2b2118;
  border: 1px solid #3d3028;
  border-radius: 20px;
  font-family: "SF Mono", "Fira Code", "Cascadia Code", Consolas, monospace;
  font-size: 14px;
  font-weight: 600;
  line-height: 1.7;
  white-space: pre;
}

.ai-code-block-inner {
  display: inline;
  min-width: max-content;
  color: #e8d5bc;
  font-family: "SF Mono", "Fira Code", "Cascadia Code", Consolas, monospace;
  font-size: 14px;
  font-weight: 600;
  line-height: 1.7;
  white-space: pre;
}

.ai-code-block-token {
  display: inline;
  font: inherit;
  white-space: pre;
}

@import "../../styles/common.wxss";

.ai-divider { width: 100%; height: 24rpx; background-repeat: repeat-x; background-position: center; background-size: auto 100%; }
.ai-divider-line-brown { background-image: linear-gradient(90deg, transparent 0 6rpx, #c4b89e 6rpx 34rpx, transparent 34rpx 46rpx); }
.ai-divider-line-teal { background-image: linear-gradient(90deg, transparent 0 6rpx, var(--ai-primary) 6rpx 34rpx, transparent 34rpx 46rpx); }
.ai-divider-line-white { background-image: linear-gradient(90deg, transparent 0 6rpx, rgba(255, 255, 255, .9) 6rpx 34rpx, transparent 34rpx 46rpx); }
.ai-divider-line-yellow { background-image: linear-gradient(90deg, transparent 0 6rpx, #f5d04a 6rpx 34rpx, transparent 34rpx 46rpx); }
.ai-divider-wave-yellow { background-image: radial-gradient(circle at 12rpx 12rpx, transparent 0 8rpx, #f5d04a 9rpx 11rpx, transparent 12rpx); background-size: 28rpx 24rpx; }
.ai-divider-dashed-brown, .ai-divider-dashed-teal, .ai-divider-dashed-white, .ai-divider-dashed-yellow { height: 16rpx; background-size: 24rpx 4rpx; }
.ai-divider-dashed-brown { background-image: linear-gradient(90deg, #c4b89e 50%, transparent 50%); }
.ai-divider-dashed-teal { background-image: linear-gradient(90deg, var(--ai-primary) 50%, transparent 50%); }
.ai-divider-dashed-white { background-image: linear-gradient(90deg, rgba(255, 255, 255, .9) 50%, transparent 50%); }
.ai-divider-dashed-yellow { background-image: linear-gradient(90deg, #f5d04a 50%, transparent 50%); }
